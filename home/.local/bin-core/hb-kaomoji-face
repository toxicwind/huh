# lab / micromamba
# shellcheck disable=SC2034
K_MU=(
	"(μ_μ)" "(・ω・)ノμ" "(｡•̀ᴗ-)✧μ" "(^人^) μ" "(^_^)/~ μ" "( •_•)ノ μ" "μ(•̀ᴗ•́)و"
	"(￣▽￣)ノμ" "(ง •̀_•́)ง μ" "( •̀ᄇ•́ )و μ" "(o‿o) μ" "(^▽^) μ" "(・◇・)？μ" "(๑˃̵ᴗ˂̵)و μ" "(˘◡˘) μ"
)

# ---------- choose mood ----------
mood="OK"
((S != 0)) && mood="ERR"
((ROOT == 1 && S == 0)) && mood="ROOT"
((BATT >= 0 && BATT < 15 && S == 0)) && mood="SLEEP"
((LONG == 1 && S == 0)) && mood="THINK"
((GDIRTY > 0 && S == 0)) && mood="DIRTY"
[[ -n "$MAMBA_ENV" && $S -eq 0 ]] && mood="MU"
((SSH == 1 && S == 0)) && mood="REMOTE"
if [[ $VIM == "vicmd" || $VIM == "NORMAL" ]]; then mood="VI"; fi
((NIGHT == 1 && S == 0)) && [[ $mood == "OK" ]] && mood="SLEEP"

# ---------- seed & print ----------
SEED=$(h32 "${PWD}|${HOSTNAME}|${mood}|${MAMBA_ENV}|$(now_s)|${J}")
case "$mood" in
ERR) pick K_ERR "$SEED" ;;
ROOT) pick K_ROOT "$SEED" ;;
THINK) pick K_THINK "$SEED" ;;
SLEEP) pick K_SLEEP "$SEED" ;;
DIRTY) pick K_DIRTY "$SEED" ;;
MU) pick K_MU "$SEED" ;;
REMOTE) pick K_REMOTE "$SEED" ;;
VI) pick K_VI "$SEED" ;;
*) pick K_OK "$SEED" ;;
esac
echo
