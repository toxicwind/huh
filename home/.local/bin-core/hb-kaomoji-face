#!/usr/bin/env bash
# Kaomortal — dynamic kaomoji engine for prompt modules.
# Cross-shell friendly; uses exported PRISM_* env from your shell hooks.

set -euo pipefail

# shellcheck disable=SC2034

# ---------- tiny utils ----------
now_s() { command -v date >/dev/null && date +%s || echo 0; }
h32() { # FNV-1a 32-bit hash (bash-safe)
	local s="$*"
	local h=2166136261 i c
	for ((i = 0; i < ${#s}; i++)); do
		printf -v c '%d' "'${s:i:1}"
		h=$(((h ^ c) * 16777619 & 0xFFFFFFFF))
	done
	echo $h
}
pick() { # pick from array by seeded index
	local -n A=$1
	local seed=$2
	local n=${#A[@]}
	((n > 0)) || {
		printf "(・_・) "
		return
	}
	printf "%s" "${A[$((seed % n))]}"
}

# ---------- context ----------
S=${PRISM_LAST_STATUS:-0}
J=${PRISM_JOBS:-0}
VIM=${PRISM_VIMODE:-INSERT}      # zsh sets this; bash defaults to INSERT
GDIRTY=${PRISM_GIT_DIRTY:-0}     # 0 clean / 1 dirty
MAMBA_ENV=${CONDA_DEFAULT_ENV:-} # micromamba/conda env name if any
SSH=${SSH_CONNECTION:+1}
ROOT=$([[ ${EUID:-$(id -u 2>/dev/null)} -eq 0 ]] && echo 1 || echo 0)
LONG=$([[ ${PRISM_CMD_MS:-0} -ge 5000 ]] && echo 1 || echo 0) # set by hook (ms)
HOUR=$(command -v date >/dev/null && date +%H || echo 12)
BAT() {
	if [[ -d /sys/class/power_supply ]]; then
		local f
		for f in /sys/class/power_supply/BAT*/capacity; do
			[[ -f "$f" ]] && {
				cat "$f"
				return
			}
		done
	fi
	command -v pmset >/dev/null && pmset -g batt 2>/dev/null |
		awk -F'; *' 'NR==1{gsub("%","",$2); print $2+0; exit}'
}
BATT=$(BAT 2>/dev/null || echo 100)
NIGHT=$([[ $HOUR -ge 0 && $HOUR -le 5 ]] && echo 1 || echo 0)

# Deterministic output for machine mode consumers
if [[ ${HB_AGENT_MODE:-} == machine || ${HB_MACHINE_MODE:-0} == 1 ]]; then
	if ((S == 0)); then
		echo ":)"
	else
		echo ":("
	fi
	exit 0
fi

