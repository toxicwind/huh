	"(o^▽^o)" "(^人^)" "(^_−)☆" "(づ｡◕‿‿◕｡)づ" "٩(ᵔᗜᵔ)و" "(っ˘ω˘ς)" "(^▽^)/" "(＾∇＾)ﾉ♪"
)
# calm / idle
# shellcheck disable=SC2034
K_IDLE=(
	"(・‿・)" "(˘︶˘)" "(￣ω￣)" "(・_・ )" "(´ｰ\`)" "( ᵕ‿ ᵕ )" "(＾_＾)" "(￣▽￣)"
	"( ¯▿¯ )" "(๑•͈ᴗ•͈) " "(・_・ヾ" "( ˘ω˘ )" "( ⁰▿⁰ )" "(._.)" "(ゝ‿◕)"
