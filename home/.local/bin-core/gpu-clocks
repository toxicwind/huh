#!/usr/bin/env bash
# gpu-clocks — lock or reset RTX 3090 clocks/power for sustained throughput.
set -euo pipefail

usage() {
	cat <<'EOT'
Usage: gpu-clocks lock [--sm MHz] [--mem MHz] | gpu-clocks reset

lock : enables persistence, disables auto-boost, sets power limit to max,
       locks SM/memory clocks (defaults to highest supported).
reset: clears locked clocks and restores auto-boost.
EOT
}

command=${1:-}
if [[ -z $command || $command == "-h" || $command == "--help" ]]; then
	usage
	if [[ -z $command ]]; then
		exit 64
	else
		exit 0
	fi
fi
shift || true

get_max_clocks() {
	nvidia-smi --query-supported-clocks=mem,gr --format=csv,noheader | head -n1 |
		awk -F',' '{gsub(/[^0-9.]/, "", $1); gsub(/[^0-9.]/, "", $2); print $1 " " $2}'
}

lock_clocks() {
	local target_sm="" target_mem=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--sm)
			target_sm=${2:?}
			shift 2
			;;
		--mem)
			target_mem=${2:?}
			shift 2
			;;
		*)
			echo "Unknown option: $1" >&2
			exit 64
			;;
		esac
	done
	read -r max_mem max_sm < <(get_max_clocks)
	target_sm=${target_sm:-$max_sm}
	target_mem=${target_mem:-$max_mem}

	sudo nvidia-smi -pm 1
	sudo nvidia-smi --auto-boost-default=DISABLED 2>/dev/null || true
	sudo nvidia-smi -acp UNRESTRICTED 2>/dev/null || true
	sudo nvidia-smi -pl 365
	sudo nvidia-smi -lgc "$target_sm","$target_sm"
	sudo nvidia-smi -lmc "$target_mem","$target_mem"
	echo "Locked clocks: SM=${target_sm} MHz, MEM=${target_mem} MHz (PL=365 W)"
}

reset_clocks() {
	sudo nvidia-smi -rac 2>/dev/null || true
	sudo nvidia-smi -rgc 2>/dev/null || true
	sudo nvidia-smi --auto-boost-default=ENABLED 2>/dev/null || true
	echo "GPU clocks reset to default boost behavior."
}

case "$command" in
lock)
	lock_clocks "$@"
	;;
reset)
	reset_clocks
	;;
*)
	usage
	exit 64
	;;
esac
