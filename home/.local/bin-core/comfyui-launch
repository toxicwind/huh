#!/usr/bin/env bash
set -euo pipefail
ENV_NAME=${ENV_NAME:-comfyui-py312}
MAMBA_BIN=${MAMBA_BIN:-$HOME/.local/bin/micromamba}
PORT=${COMFYUI_PORT:-8188}
HOST=${COMFYUI_HOST:-127.0.0.1}
export PYTHONUNBUFFERED=1
export TQDM_DISABLE=${TQDM_DISABLE:-1}
cd /home/toxic/sd/ComfyUI
if [[ "${SKIP_SET_GPU:-0}" != "1" ]] && command -v set-gpu >/dev/null 2>&1; then
	set-gpu >/tmp/comfyui-set-gpu.log 2>&1 || {
		echo "[warn] set-gpu failed, see /tmp/comfyui-set-gpu.log" >&2
	}
fi
exec "$MAMBA_BIN" run -n "$ENV_NAME" python main.py --listen "$HOST" --port "$PORT" --use-sage-attention --fast "$@"
