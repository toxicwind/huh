#!/usr/bin/env bash
# Configure and activate adaptive SD GPU profile
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: set-gpu-sd [--profile NAME] [--gpu ID] [--config PATH] [--set KEY=VALUE] [--dry-run] [--no-restart]

Profiles:
  sd-max          Default. Aggressive SD profile with power smoothing, targets <75% fan.
  sd-default      Legacy proactive cooling, clamps heat early without max fan blast.
  quiet           Conservative ramp, keeps fans <70% where possible.
  balanced        Moderate ramp, steadier power for mixed desktop + SD.
  sdxl-extreme    High-load tuned for SDXL throughput.

Overrides:
  --set KEY=VALUE    Inject/override config entry (e.g. --set TEMP_MAX=80).
  --dry-run          Show planned config without writing or restarting.
  --no-restart       Write config but skip systemctl restart.
EOF
}

profile="sd-max"
gpu="${GPU:-0}"
config_path="/etc/sysconfig/sd-quiet"
dry_run=false
no_restart=false
declare -a overrides=()

run_priv() {
	if [[ $EUID -eq 0 ]]; then
		"$@"
	else
		sudo "$@"
	fi
}

while (($#)); do
	case "$1" in
	--profile)
		profile="${2:-}"
		shift 2
		;;
	--gpu)
		gpu="${2:-}"
		shift 2
		;;
	--config)
		config_path="${2:-}"
		shift 2
		;;
	--set)
		overrides+=("${2:-}")
		shift 2
		;;
	--dry-run)
		dry_run=true
		shift
		;;
	--no-restart)
		no_restart=true
		shift
		;;
	--help | -h)
		usage
		exit 0
		;;
	--*)
		echo "Unknown option: $1" >&2
		usage >&2
		exit 1
		;;
	*)
		gpu="$1"
		shift
		;;
	esac
done

if [[ -z "$gpu" ]]; then
	echo "GPU ID cannot be empty" >&2
	exit 1
fi

declare -A cfg
cfg[GPU]="$gpu"

normalise_profile() {
	case "$1" in
	sd-max | max | default | sdxl | max-default | sdxl-max) echo sd-max ;;
	sd-default | default-low) echo sd-default ;;
	quiet) echo quiet ;;
	balanced) echo balanced ;;
	extreme | sdxl_extreme | sdxl-extreme) echo sdxl-extreme ;;
	*)
		echo "sd-max"
		;;
	esac
}

profile_normalised="$(normalise_profile "${profile,,}")"
cfg[PROFILE]="$profile_normalised"

apply_profile_defaults() {
	case "$profile_normalised" in
	sd-max)
		cfg[FAN_MIN]=58
		cfg[FAN_MAX]=73
		cfg[FAN_SPIKE]=80
		cfg[TEMP_TARGET]=76
		cfg[TEMP_MAX]=81
		cfg[TEMP_CEIL]=84
		cfg[UTIL_HIGH]=90
		cfg[UTIL_LOW]=55
		cfg[STEP_UP]=18
		cfg[STEP_DOWN]=18
		cfg[STEP_IDLE]=10
		cfg[PL_FLOOR_RATIO]=78
		cfg[PL_CEIL_RATIO]=96
		cfg[RAMP_DELAY]=1
		cfg[INTERVAL]=2
		cfg[LOG_EVERY]=4
		;;
	sd-default)
		cfg[FAN_MIN]=60
		cfg[FAN_MAX]=78
		cfg[FAN_SPIKE]=85
		cfg[TEMP_TARGET]=74
		cfg[TEMP_MAX]=80
		cfg[TEMP_CEIL]=83
		cfg[UTIL_HIGH]=85
		cfg[UTIL_LOW]=50
		cfg[STEP_UP]=18
		cfg[STEP_DOWN]=20
		cfg[STEP_IDLE]=12
		cfg[PL_FLOOR_RATIO]=72
		cfg[PL_CEIL_RATIO]=92
		cfg[RAMP_DELAY]=1
		cfg[INTERVAL]=3
		cfg[LOG_EVERY]=5
		;;
	quiet)
		cfg[FAN_MIN]=58
		cfg[FAN_MAX]=70
		cfg[FAN_SPIKE]=78
		cfg[TEMP_TARGET]=74
		cfg[TEMP_MAX]=78
		cfg[TEMP_CEIL]=82
		cfg[UTIL_HIGH]=75
		cfg[UTIL_LOW]=40
		cfg[STEP_UP]=8
		cfg[STEP_DOWN]=10
		cfg[STEP_IDLE]=6
		cfg[PL_FLOOR_RATIO]=68
		cfg[PL_CEIL_RATIO]=84
		cfg[RAMP_DELAY]=2
		cfg[INTERVAL]=5
		cfg[LOG_EVERY]=6
		;;
	balanced)
		cfg[FAN_MIN]=55
		cfg[FAN_MAX]=74
		cfg[FAN_SPIKE]=82
		cfg[TEMP_TARGET]=76
		cfg[TEMP_MAX]=80
		cfg[TEMP_CEIL]=84
		cfg[UTIL_HIGH]=82
		cfg[UTIL_LOW]=55
		cfg[STEP_UP]=12
		cfg[STEP_DOWN]=16
		cfg[STEP_IDLE]=10
		cfg[PL_FLOOR_RATIO]=74
		cfg[PL_CEIL_RATIO]=90
		cfg[RAMP_DELAY]=2
		cfg[INTERVAL]=4
		cfg[LOG_EVERY]=5
		;;
	sdxl-extreme)
		cfg[FAN_MIN]=52
		cfg[FAN_MAX]=76
		cfg[FAN_SPIKE]=84
		cfg[TEMP_TARGET]=78
		cfg[TEMP_MAX]=82
		cfg[TEMP_CEIL]=85
		cfg[UTIL_HIGH]=88
		cfg[UTIL_LOW]=60
		cfg[STEP_UP]=18
		cfg[STEP_DOWN]=22
		cfg[STEP_IDLE]=14
		cfg[PL_FLOOR_RATIO]=76
		cfg[PL_CEIL_RATIO]=94
		cfg[RAMP_DELAY]=1
		cfg[INTERVAL]=3
		cfg[LOG_EVERY]=4
		;;
	esac
}

apply_profile_defaults

for pair in "${overrides[@]}"; do
	if [[ "$pair" != *"="* ]]; then
		echo "Invalid override (expected KEY=VALUE): $pair" >&2
		exit 1
	fi
	key="${pair%%=*}"
	value="${pair#*=}"
	if [[ -z "$key" ]]; then
		echo "Override key cannot be empty" >&2
		exit 1
	fi
	cfg["$key"]="$value"
done

timestamp="$(date -Iseconds)"
declare -a preserved_lines=()
if [[ -f "$config_path" ]]; then
	while IFS= read -r line; do
		[[ "$line" =~ ^(GAME_|CUSTOM_) ]] && preserved_lines+=("$line")
	done <"$config_path"
fi

keys=(
	GPU
	PROFILE
	FAN_MIN
	FAN_MAX
	FAN_SPIKE
	TEMP_TARGET
	TEMP_MAX
	TEMP_CEIL
	UTIL_HIGH
	UTIL_LOW
	STEP_UP
	STEP_DOWN
	STEP_IDLE
	PL_FLOOR_RATIO
	PL_CEIL_RATIO
	RAMP_DELAY
	INTERVAL
	LOG_EVERY
)

build_config() {
	{
		printf '# sd-quiet profile generated by set-gpu-sd on %s\n' "$timestamp"
		printf '# profile=%s gpu=%s\n' "${cfg[PROFILE]}" "${cfg[GPU]}"
		for key in "${keys[@]}"; do
			printf '%s=%s\n' "$key" "${cfg[$key]}"
		done
		if ((${#overrides[@]} > 0)); then
			printf '# overrides applied:\n'
			for pair in "${overrides[@]}"; do
				printf '#   %s\n' "$pair"
			done
		fi
		for line in "${preserved_lines[@]}"; do
			printf '%s\n' "$line"
		done
	} | sed 's/[[:space:]]\+$//'
}

echo "[*] set-gpu-sd → profile ${cfg[PROFILE]} on GPU ${cfg[GPU]}"

if $dry_run; then
	echo "[=] Dry run, generated config:"
	build_config
	exit 0
fi

tmpfile="$(mktemp)"
trap 'rm -f "$tmpfile"' EXIT
build_config >"$tmpfile"

if [[ -f "$config_path" ]]; then
	backup="${config_path}.bak-$(date +%Y%m%d%H%M%S)"
	echo "[*] Backing up existing config to $backup"
	run_priv cp "$config_path" "$backup"
fi

echo "[*] Installing new config to $config_path"
run_priv install -Dm644 "$tmpfile" "$config_path"

echo "[*] Ensuring sd-quiet.service is enabled"
run_priv systemctl enable --now sd-quiet.service >/dev/null 2>&1 || true

if ! $no_restart; then
	echo "[*] Restarting sd-quiet.service"
	run_priv systemctl restart sd-quiet.service
else
	echo "[!] Skipping restart (requested)"
fi

read -r MIN DEF MAX < <(LC_ALL=C nvidia-smi --query-gpu=power.min_limit,power.default_limit,power.max_limit --format=csv,noheader,nounits -i "${cfg[GPU]}" | head -n1 | tr ',' ' ')
if [[ -n "${MIN:-}" && -n "${DEF:-}" && -n "${MAX:-}" ]]; then
	echo "[✓] Active power window ${MIN}-${MAX} W (default ${DEF} W)"
else
	echo "[!] Unable to read power window; check nvidia-smi output."
fi
